{
  // Help Center contact Worker. Deployed once by the Miden team with
  // `npx wrangler@4.131.1 deploy` from this folder, logged in to the Cloudflare
  // account that holds miden.xyz. It needs no API key and no secret.
  "name": "wallet-support-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // Creates contact.miden.xyz on deploy. Only the form uses this address.
  "routes": [{ "pattern": "contact.miden.xyz", "custom_domain": true }],
  "workers_dev": false,

  // Cloudflare's built-in email. Sending to a verified destination address is
  // free and needs no key; the address is verified once under Email Routing.
  "send_email": [{ "name": "EMAIL", "destination_address": "support@miden.team" }],

  // At most 3 reports a minute from one connection. Cloudflare accepts a
  // period of 10 or 60 seconds.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "4101", "simple": { "limit": 3, "period": 60 } }],

  // Keeps the Worker's logs, so a failed send shows its error code.
  "observability": { "enabled": true },

  "vars": {
    "ALLOWED_ORIGIN": "https://support.miden.xyz",
    "FROM_ADDRESS": "help-center@miden.xyz",
    "TO_ADDRESS": "support@miden.team"
  }

  // TURNSTILE_SECRET is optional and set with `npx wrangler secret put`.
  // Without it the Worker skips the bot check.
}
