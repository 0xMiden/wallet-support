{
  "name": "wallet-support-feedback",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute wallet-support-feedback --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute wallet-support-feedback --local --file=./schema.sql",
    "test": "npm run check:migrations --silent && vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "check:schema": "python3 scripts/validate-migrations.py",
    "check:migrations": "python3 scripts/validate-migrations.py",
    "test:oauth": "node test/browser/oauth-samesite.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260813.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
