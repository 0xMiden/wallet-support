{
  "name": "bread-wallet-help-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --no-file-parallelism",
    "verify": "yarn typecheck && yarn test && yarn e2e && yarn build",
    "worker:typecheck": "npm --prefix worker/feedback run typecheck",
    "worker:test": "npm --prefix worker/feedback test",
    "verify:all": "yarn verify && yarn worker:typecheck && yarn worker:test",
    "deploy:worker": "yarn build && npm --prefix worker/feedback run deploy",
    "e2e": "playwright test",
    "check:links": "node scripts/check-external-links.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "check:preview-freshness": "node scripts/check-preview-freshness.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22",
    "@types/react": "18.2.76",
    "@types/react-dom": "18.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "resolutions": {
    "vite": "8.0.16"
  }
}
