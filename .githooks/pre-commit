#!/usr/bin/env bash
#
# Runs the checks that would otherwise only be run by hand. Everything here is
# local and offline: tsc and vitest come from node_modules, and nothing contacts
# a network or an external service.
#
# Enable once per clone (see README):
#   git config core.hooksPath .githooks
#
# Skip a single commit with `git commit --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Docs-only commits cannot break a typecheck or a unit test, so skip them and
# keep the hook instant. Anything touching code, types, dependencies, or article
# content runs. Content counts because the fidelity test compares the migrated
# articles against content-source/, so a change to either side must re-run it.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$staged" | grep -qE '\.(ts|tsx)$|(^|/)(package\.json|yarn\.lock|tsconfig\.json|vite\.config\.ts)$|^(content-source|src/help-center/content)/'; then
  echo "pre-commit: no code or content changes staged, skipping checks."
  exit 0
fi

if [ ! -x node_modules/.bin/tsc ] || [ ! -x node_modules/.bin/vitest ]; then
  echo "pre-commit: node_modules is missing or incomplete. Run 'yarn install' first." >&2
  exit 1
fi

echo "pre-commit: typecheck"
yarn typecheck

echo "pre-commit: tests"
# --no-file-parallelism is deliberate: this project's suite is small and pure, and
# an unbounded worker pool is the failure mode this host has been bitten by.
NODE_OPTIONS=--max-old-space-size=1536 ./node_modules/.bin/vitest run --no-file-parallelism

echo "pre-commit: ok"
