# REVIEW TEMPLATE ONLY. GitHub does not load this extension.
# Complete docs/CI-DEPLOYMENT.md before renaming; no activation is authorized.
name: Deploy support production
on:
  workflow_run:
    workflows: [Verify]
    types: [completed]
    branches: [main]
permissions:
  contents: read
concurrency:
  group: support-production
  cancel-in-progress: false
jobs:
  deploy:
    if: >-
      ${{ vars.SUPPORT_PRODUCTION_AUTO_DEPLOY == 'true' &&
          github.repository == '0xMiden/wallet-support' &&
          github.event.workflow_run.conclusion == 'success' &&
          github.event.workflow_run.event == 'push' &&
          github.event.workflow_run.head_branch == 'main' &&
          github.event.workflow_run.head_repository.full_name == github.repository }}
    environment: support-production
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    env:
      VITE_TURNSTILE_SITE_KEY: ${{ vars.VITE_TURNSTILE_SITE_KEY }}
      CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.workflow_run.head_sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Refuse a superseded main commit
        env:
          TESTED_SHA: ${{ github.event.workflow_run.head_sha }}
        run: |
          test "$(git rev-parse HEAD)" = "$TESTED_SHA"
          test "$(git rev-parse origin/main)" = "$TESTED_SHA"
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: 22
          cache: yarn
      - run: node scripts/check-production-deploy.mjs
      - run: yarn install --frozen-lockfile
      - run: npm ci --prefix worker/feedback
      - run: yarn playwright install --with-deps chromium
      # Rebuild and exercise the frontend using the real public production key.
      - run: yarn verify
      # Existing script checks clean tree, built key, canonical Worker and remote
      # secret NAMES, then tags the SHA and exposes it through /health.
      # No D1 migration, secret upload, App install or write-switch activation.
      - run: |
          test -n "$CLOUDFLARE_API_TOKEN"
          npm --prefix worker/feedback run deploy
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
      - name: Check production health and running commit
        env:
          TESTED_SHA: ${{ github.event.workflow_run.head_sha }}
        run: node scripts/check-production-health.mjs
